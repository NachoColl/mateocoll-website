---
layout: base.njk
---

<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{ site.tagline }}</h1>
  </div>

  <a href="#projects" class="scroll-indicator" aria-label="Scroll down">
    <svg width="24" height="32" viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2L12 28M12 28L6 22M12 28L18 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</section>

<section class="work-grid" id="projects">
  <div class="container">
    <nav class="category-filters">
      <button class="filter-btn active" data-category="all">Todos</button>
      <span class="filter-separator">|</span>
      <button class="filter-btn" data-category="cortometrajes">Cortometrajes</button>
    </nav>

    <div class="projects-grid">
      {% for project in projects.projects %}
      <article class="project-card" data-project="{{ project.slug }}" data-category="{{ project.category }}">
        <a href="/project/{{ project.slug }}/">
          <div class="media-container">
            <img class="thumbnail" src="{{ project.thumbnail }}" alt="{{ project.title }}" loading="lazy">
            <video class="preview-video" muted loop playsinline preload="none">
              <source src="{{ project.previewVideo }}" type="video/mp4">
            </video>
          </div>
          <h3 class="project-title">{{ project.title }}</h3>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<script src="/assets/js/category-filter.js"></script>
<script src="/assets/js/video-preview.js"></script>
