<header class="site-header">
  <div class="container">
    <a href="{{ '/' | url }}" class="logo">{{ site.name }}</a>

    <nav class="main-nav">
      <ul>
        <li><a href="{{ '/' | url }}" {% if page.url == "/" %}class="active"{% endif %}>Trabajos</a></li>
        <li><a href="{{ '/contact/' | url }}" {% if page.url == "/contact/" %}class="active"{% endif %}>Contacto</a></li>
        <li class="lang-switcher-nav">
          <a href="{{ page.url | url }}" class="lang-link active">ESP</a>
          <span class="lang-separator">/</span>
          <a href="{{ ('/fr' + page.url) | url }}" class="lang-link">FR</a>
          <span class="lang-separator">/</span>
          <a href="{{ ('/en' + page.url) | url }}" class="lang-link">EN</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
