---
layout: base.njk
permalink: /contact/
---

<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{ contact.hero.title }}</h1>
    <p class="hero-subtitle">{{ contact.hero.subtitle }}</p>
  </div>
</section>

<section class="contact-content">
  <div class="container">
    <div class="contact-grid">
      <form action="https://formspree.io/f/{{ contact.form.formspreeId }}" method="POST" class="contact-form">
        <div class="form-group">
          <label for="topic">Asunto</label>
          <select name="topic" id="topic" required>
            {% for topic in contact.form.topics %}
            <option value="{{ topic }}">{{ topic }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="form-group">
          <label for="name">Nombre</label>
          <input type="text" name="name" id="name" required>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required>
        </div>

        <div class="form-group">
          <label for="message">Mensaje</label>
          <textarea name="message" id="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn-submit">Enviar mensaje</button>
      </form>

      <div class="contact-info">
        <div class="info-item">
          <span class="label">Teléfono</span>
          <span class="value">{{ contact.phone }}</span>
        </div>

        <div class="info-item">
          <span class="label">Ubicación</span>
          <span class="value">{{ contact.address }}</span>
        </div>

        <div class="social-links">
          {% for social in contact.social %}
          <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer">
            {{ social.platform }}
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
